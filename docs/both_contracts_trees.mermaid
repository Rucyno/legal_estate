flowchart LR
    %% =========================================================================
    %% ЛЕВАЯ КОЛОНКА: ПРЕДВАРИТЕЛЬНЫЙ ДОГОВОР (ПДКП)
    %% =========================================================================
    subgraph PDKP_TREE ["📘 ПРЕДВАРИТЕЛЬНЫЙ ДОГОВОР КУПЛИ-ПРОДАЖИ (ПДКП)"]
        direction TB

        subgraph P_HEAD ["Шапка ПДКП"]
            P_CITY["Место заключения (город)"]
            P_TITLE["БЛОЧНАЯ СТРУКТУРА ПДКП"]
            P_DATE["Дата заключения"]
        end

        subgraph P_PARTIES ["Стороны ПДКП"]
            direction LR
            subgraph P_SELLER_BOX ["🟦 СТОРОНА ПРОДАВЦА"]
                P_S_MAIN["Продавец (Собственник)"]
                subgraph P_S_TYPES ["Варианты Продавца"]
                    P_S1["1, 2, 3 Взрослых собственника"]
                    P_S2["1, 2, 3 До 14 лет (родители)"]
                    P_S3["1, 2, 3 От 14 до 18 лет (с согласия)"]
                    P_S4["2 Взрослых супруга (совместная)"]
                end
            end

            subgraph P_BUYER_BOX ["🟥 СТОРОНА ПОКУПАТЕЛЯ"]
                P_B_MAIN["Покупатель (Приобретатель)"]
                subgraph P_B_TYPES ["Варианты Покупателя"]
                    P_B1["1, 2, 3 Взрослых покупателя"]
                    P_B2["1, 2, 3 До 14 лет (родители)"]
                    P_B3["1, 2, 3 От 14 до 18 лет (с согласия)"]
                    P_B4["2 Взрослых супруга (совместная / долевая)"]
                end
            end
        end

        subgraph P_CORE ["Предмет и объект ПДКП"]
            P_PREDMET["1. ПРЕДМЕТ: Обязательство заключить в будущем ОДКП до срока (дедлайн)"]
            P_DESC["2. ОПИСАТЕЛЬНЫЕ ДАННЫЕ: Адрес, кад. номер, площадь, правоустановка, мебель/техника"]

            subgraph P_OBJECTS ["Виды объектов (1 или связка)"]
                P_O1["Квартира"]
                P_O2["Жилой дом + Земельный участок"]
                P_O3["Земельный участок (ИЖС/СНТ)"]
                P_O4["ЗУ + Нежилое строение (баня, гараж)"]
                P_O5["Комната в коммуналке (ст. 250 ГК)"]
                P_O6["Нежилое коммерческое помещение"]
                P_O7["Нежилое коммерческое + ЗУ"]
            end

            P_SHARE["Режим: ДОЛЯ В ПРАВЕ"]
            P_WHOLE["Режим: ОБЪЕКТ ЦЕЛИКОМ"]
        end

        subgraph P_FINANCE ["Финансы и расчеты"]
            P_PRICE["Полная цена объекта и сумма ЗАДАТКА (ст. 380-381 ГК РФ)"]
            P_SETTLE["Сценарии расчетов (24 ветки: Наличные / СБР / Аккредитив / Ячейка / Ипотека / МСК)"]
        end

        subgraph P_PREP ["Подготовка к сделке"]
            P_DOCS_S["Документы Продавца: выписка ЕГРН, ЖКХ, СФР по МСК, ПНД/НД"]
            P_COND["Действия: приказ опеки, согласие супруга, одобрение банка, снятие залогов"]
            P_DOCS_B["Документы Покупателя: паспорта, кредитный договор, подтверждение средств"]
        end

        subgraph P_LEGAL ["Защитные условия ПДКП"]
            P_PARITET["3. ПАРИТЕТ НАМЕРЕНИЙ (Заверения об обстоятельствах ст. 431.2 ГК РФ)"]
            P_REG["4. ЗАРЕГИСТРИРОВАННЫЕ ЛИЦА (Снятие с учета до сделки или в срок после)"]
            P_KEYS["5. СРОКИ ОСВОБОЖДЕНИЯ И КЛЮЧИ (Передаточный акт ст. 556 ГК РФ)"]
            P_LIAB["6. ОТВЕТСТВЕННОСТЬ (Судьба задатка ст. 381 ГК, неустойка 0.1%/день)"]
            P_FORCE["7. ФОРС-МАЖОР (ст. 401 ГК, отказ банка, мобилизация)"]
            P_CLOSE["8. ЗАКЛЮЧИТЕЛЬНЫЕ ПОЛОЖЕНИЯ И ПОДПИСИ (Построчно на всю ширину)"]
        end

        P_HEAD --> P_PARTIES
        P_S_MAIN --> P_S_TYPES
        P_B_MAIN --> P_B_TYPES
        P_S_MAIN --> P_PREDMET
        P_B_MAIN --> P_PREDMET
        P_PREDMET --> P_DESC
        P_DESC --> P_OBJECTS
        P_OBJECTS --> P_SHARE
        P_OBJECTS --> P_WHOLE
        P_B_MAIN --> P_FINANCE
        P_FINANCE --> P_S_MAIN
        P_S_MAIN --> P_PREP
        P_B_MAIN --> P_PREP
        P_S_MAIN --> P_LEGAL
        P_B_MAIN --> P_LEGAL
    end

    %% =========================================================================
    %% ПРАВАЯ КОЛОНКА: ОСНОВНОЙ ДОГОВОР (ОДКП)
    %% =========================================================================
    subgraph ODKP_TREE ["📗 ОСНОВНОЙ ДОГОВОР КУПЛИ-ПРОДАЖИ (ОДКП)"]
        direction TB

        subgraph O_HEAD ["Шапка ОДКП"]
            O_CITY["Место заключения (город)"]
            O_TITLE["БЛОЧНАЯ СТРУКТУРА ОДКП"]
            O_DATE["Дата заключения"]
        end

        subgraph O_PARTIES ["Стороны ОДКП (Переход права)"]
            direction LR
            subgraph O_SELLER_BOX ["🟦 СТОРОНА ПРОДАВЦА"]
                O_S_MAIN["Продавец (Собственник)"]
                subgraph O_S_TYPES ["Режим отчуждения Продавца"]
                    O_S1["1, 2, 3 Взрослых собственника"]
                    O_S2["1, 2, 3 До 14 лет (приказ опеки + нотариус)"]
                    O_S3["1, 2, 3 От 14 до 18 лет (согласие + опека)"]
                    O_S4["2 Взрослых супруга (согласие ст. 35 СК)"]
                end
            end

            subgraph O_BUYER_BOX ["🟥 СТОРОНА ПОКУПАТЕЛЯ"]
                O_B_MAIN["Покупатель (Приобретатель)"]
                subgraph O_B_TYPES ["Режим приобретения Покупателя"]
                    O_B1["В индивидуальную собственность"]
                    O_B2["В общую совместную собственность супругов"]
                    O_B3["В общую долевую собственность (доли)"]
                    O_B4["С участием детей (маткапитал 256-ФЗ)"]
                end
            end
        end

        subgraph O_CORE ["Предмет договора и объект (ст. 549-550 ГК)"]
            O_PREDMET["1. ПРЕДМЕТ: Продавец передает в собственность, а Покупатель принимает и оплачивает"]
            O_DESC["2. ОПИСАТЕЛЬНЫЕ ДАННЫЕ: Адрес ФИАС, кад. номер, площадь, этаж, документы-основания"]

            subgraph O_OBJECTS ["Виды объектов (1 или связка)"]
                O_O1["Квартира"]
                O_O2["Жилой дом + Земельный участок (ст. 552, 555 ГК)"]
                O_O3["Земельный участок (ИЖС/СНТ)"]
                O_O4["ЗУ + Нежилое строение (баня, гараж)"]
                O_O5["Комната в коммуналке (отказы ст. 250 ГК)"]
                O_O6["Нежилое коммерческое помещение"]
                O_O7["Нежилое коммерческое + ЗУ"]
            end

            O_SHARE["Форма: ДОЛЯ В ПРАВЕ"]
            O_WHOLE["Форма: ОБЪЕКТ ЦЕЛИКОМ"]
        end

        subgraph O_FINANCE ["Цена и исполнение расчетов"]
            O_PRICE["Полная цена (при Доме+ЗУ - раздельные цены ст. 555 ГК)"]
            O_OFFSET["Зачет ранее внесенного задатка/аванса по ПДКП"]
            O_SETTLE["Финальный расчет: СБР / Аккредитив / Ячейка / Наличные"]
            O_MORTGAGE["Ипотечные средства банка (ст. 77 / 64.1 / 64.2 102-ФЗ, залог в силу закона)"]
            O_MATCAP["Средства МСК / Сертификаты (безналично из СФР РФ до 21 дня)"]
            O_NOPLEDGE["Отказ от залога Продавца (п. 5 ст. 488 ГК РФ НЕ возникает)"]
        end

        subgraph O_REG ["Государственная регистрация права (ст. 551 ГК)"]
            O_FILING["Подача: Электронная регистрация / Нотариус / МФЦ Росреестра"]
            O_MOMENT["Момент перехода права: внесение записи в ЕГРН (ст. 8.1, 223 ГК)"]
            O_FEES["Расходы: госпошлина, сервис регистрации, банк"]
        end

        subgraph O_LEGAL ["Существенные и защитные условия ОДКП"]
            O_USERS["3. ПРАВА ПОЛЬЗОВАНИЯ (ст. 558 ГК РФ): отсутствие проживающих / выписка за N дней"]
            O_ACT["4. ПЕРЕДАЧА ОБЪЕКТА (ст. 556 ГК РФ): Передаточный акт в срок N дней / договор как акт"]
            O_WARR["5. ЗАВЕРЕНИЯ ОБ ОБСТОЯТЕЛЬСТВАХ (ст. 431.2, 460, 461 ГК): юр. чистота, нет банкротства 127-ФЗ"]
            O_LIAB["6. ОТВЕТСТВЕННОСТЬ: пени 0.1%/день за задержку расчета/выезда, ст. 461 ГК убытки"]
            O_FORCE["7. ФОРС-МАЖОР (ст. 401 ГК РФ)"]
            O_CLOSE["8. АДРЕСА, РЕКВИЗИТЫ И ПОДПИСИ (Построчный формат на всю ширину 17 см)"]
        end

        O_HEAD --> O_PARTIES
        O_S_MAIN --> O_S_TYPES
        O_B_MAIN --> O_B_TYPES
        O_S_MAIN --> O_PREDMET
        O_B_MAIN --> O_PREDMET
        O_PREDMET --> O_DESC
        O_DESC --> O_OBJECTS
        O_OBJECTS --> O_SHARE
        O_OBJECTS --> O_WHOLE
        O_B_MAIN --> O_FINANCE
        O_FINANCE --> O_S_MAIN
        O_S_MAIN --> O_REG
        O_B_MAIN --> O_REG
        O_S_MAIN --> O_LEGAL
        O_B_MAIN --> O_LEGAL
    end
