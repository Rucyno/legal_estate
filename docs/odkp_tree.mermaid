flowchart TD
    %% ШАПКА
    subgraph TITLE_BLOCK_O ["📄 ШАПКА ОДКП"]
        CITY_O["Место заключения (город)"] --- TITLE_O["БЛОЧНАЯ СТРУКТУРА ОСНОВНОГО ДОГОВОРА (ОДКП)"] --- DATE_O["Дата заключения"]
    end

    %% ВЕРТИКАЛЬ СУЩЕСТВЕННЫХ И ЗАЩИТНЫХ УСЛОВИЙ
    subgraph ESSENTIAL_COLUMN ["⚖️ СУЩЕСТВЕННЫЕ И ЗАЩИТНЫЕ УСЛОВИЯ ОДКП"]
        direction TB
        O_CLOSE["8. Адреса, реквизиты и подписи (построчно на всю ширину 17 см)"]
        O_FORCE["7. Форс-мажор (ст. 401 ГК РФ)"]
        O_LIAB["6. Ответственность: неустойка 0.1%/день за задержку расчета/выезда, ст. 461 ГК убытки"]
        O_WARR["5. Заверения об обстоятельствах (ст. 431.2, 460, 461 ГК): юр. чистота, нет банкротства 127-ФЗ"]
        O_ACT["4. Передача объекта (ст. 556 ГК РФ): Передаточный акт в срок N дней / договор как акт"]
        O_USERS["3. Права пользования (ст. 558 ГК РФ): отсутствие проживающих / выписка за N дней"]

        O_CLOSE --- O_FORCE
        O_FORCE --- O_LIAB
        O_LIAB --- O_WARR
        O_WARR --- O_ACT
        O_ACT --- O_USERS
    end

    %% ГОСУДАРСТВЕННАЯ РЕГИСТРАЦИЯ ПРАВА (СТ. 551 ГК)
    subgraph REG_BOX ["🏛️ ГОСУДАРСТВЕННАЯ РЕГИСТРАЦИЯ ПРАВА (СТ. 551 ГК)"]
        O_FILING["Подача: Электронная регистрация / Нотариус / МФЦ Росреестра"]
        O_MOMENT["Момент перехода права: внесение записи в ЕГРН (ст. 8.1, 223 ГК)"]
        O_FEES["Распределение расходов: госпошлина, сервис регистрации, банк"]
        O_FILING --- O_MOMENT --- O_FEES
    end

    %% ФИНАНСЫ И ИСПОЛНЕНИЕ РАСЧЕТОВ
    subgraph FINANCE_BOX ["💰 ЦЕНА ДОГОВОРА И ИСПОЛНЕНИЕ РАСЧЕТОВ"]
        direction TB
        O_PRICE["Полная цена (при Доме+ЗУ - раздельные цены ст. 555 ГК)"]
        O_OFFSET["Зачет ранее внесенного задатка/аванса по ПДКП"]
        O_SETTLE["Финальный расчет: СБР / Аккредитив / Ячейка / Наличные"]
        O_MORTGAGE["Ипотечные средства банка (ст. 77 / 64.1 / 64.2 102-ФЗ, залог в силу закона)"]
        O_MATCAP["Средства МСК / Сертификаты (безналично из СФР РФ до 21 дня)"]
        O_NOPLEDGE["Отказ от залога Продавца (п. 5 ст. 488 ГК РФ НЕ возникает)"]
        O_PRICE --- O_OFFSET --- O_SETTLE --- O_MORTGAGE --- O_MATCAP --- O_NOPLEDGE
    end

    %% ЦЕНТРАЛЬНЫЙ БЛОК: СТОРОНЫ И ПРЕДМЕТ
    subgraph SIDES_ROW_O ["👥 СТОРОНЫ И ПЕРЕХОД ПРАВА СОБСТВЕННОСТИ"]
        subgraph SELLER_BOX_O ["🟦 СТОРОНА ПРОДАВЦА"]
            direction TB
            SO_MAIN["Продавец (Собственник)"]
            SO1["1, 2, 3 Взрослых собственника"]
            SO2["1, 2, 3 До 14 лет (приказ опеки + нотариус)"]
            SO3["1, 2, 3 От 14 до 18 лет (согласие + опека)"]
            SO4["2 Взрослых супруга (согласие ст. 35 СК)"]
            SO_MAIN --- SO1 --- SO2 --- SO3 --- SO4
        end

        subgraph CORE_BOX_O ["🎯 ПРЕДМЕТ ДОГОВОРА (СТ. 549-550 ГК)"]
            direction TB
            PREDMET_O["1. Предмет ОДКП: Продавец передает в собственность,\nа Покупатель принимает и оплачивает объект"]
            DESC_O["2. Описательные данные: адрес ФИАС, кад. номер,\nплощадь, этаж, документы-основания права"]
            PREDMET_O --> DESC_O
        end

        subgraph BUYER_BOX_O ["🟥 СТОРОНА ПОКУПАТЕЛЯ"]
            direction TB
            BO_MAIN["Покупатель (Приобретатель)"]
            BO1["В индивидуальную собственность"]
            BO2["В общую совместную собственность супругов"]
            BO3["В общую долевую собственность (доли)"]
            BO4["С участием детей (маткапитал 256-ФЗ)"]
            BO_MAIN --- BO1 --- BO2 --- BO3 --- BO4
        end
    end

    %% КАТАЛОГ ОБЪЕКТОВ
    subgraph OBJECTS_BOX_O ["🏢 ВИДЫ ОБЪЕКТОВ (1 ИЛИ НЕСКОЛЬКО В СДЕЛКЕ)"]
        direction TB
        subgraph OBJ_LIST_O ["Список объектов"]
            OO1["Квартира"]
            OO2["Жилой дом + Земельный участок (ст. 552, 555 ГК)"]
            OO3["Земельный участок (ИЖС/СНТ)"]
            OO4["ЗУ + Нежилое строение (баня, гараж)"]
            OO5["Комната в коммуналке (отказы ст. 250 ГК)"]
            OO6["Нежилое коммерческое помещение"]
            OO7["Нежилое коммерческое + ЗУ"]
        end
        STATUS_SHARE_O["Форма: ДОЛЯ В ПРАВЕ"]
        STATUS_WHOLE_O["Форма: ОБЪЕКТ ЦЕЛИКОМ"]
        OBJ_LIST_O --> STATUS_SHARE_O
        OBJ_LIST_O --> STATUS_WHOLE_O
    end

    %% СВЯЗИ
    SO_MAIN --> ESSENTIAL_COLUMN
    BO_MAIN --> ESSENTIAL_COLUMN
    SO_MAIN --> REG_BOX
    BO_MAIN --> REG_BOX
    BO_MAIN --> FINANCE_BOX --> SO_MAIN
    SO_MAIN --> PREDMET_O
    BO_MAIN --> PREDMET_O
    DESC_O --> OBJECTS_BOX_O
