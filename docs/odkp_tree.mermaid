flowchart TD
    %% Шапка договора
    subgraph TITLE_BLOCK ["📄 ШАПКА ДОГОВОРА"]
        CITY_L["Место заключения (город)"]
        TITLE_C["БЛОЧНАЯ СТРУКТУРА ОСНОВНОГО ДОГОВОРА (ОДКП)"]
        DATE_R["Дата заключения"]
    end

    %% Стороны договора
    subgraph PARTIES ["👥 СТОРОНЫ ДОГОВОРА (ПЕРЕХОД ПРАВА)"]
        direction LR
        subgraph SELLER_BOX ["🟦 СТОРОНА ПРОДАВЦА"]
            S_MAIN["Продавец (Собственник)"]
            subgraph S_TYPES ["Режим отчуждения Продавца"]
                S_A["1, 2, 3 Взрослых собственника"]
                S_U14["1, 2, 3 Собственника до 14 лет (приказ опеки + нотариус)"]
                S_1418["1, 2, 3 Собственника от 14 до 18 лет (согласие + опека)"]
                S_SPOUSE["2 Взрослых супруга (согласие супруга ст. 35 СК РФ)"]
            end
        end

        subgraph BUYER_BOX ["🟥 СТОРОНА ПОКУПАТЕЛЯ"]
            B_MAIN["Покупатель (Приобретатель)"]
            subgraph B_TYPES ["Режим приобретения Покупателя"]
                B_INDIV["В индивидуальную собственность (1 покупатель)"]
                B_SPOUSE_JOINT["В общую совместную собственность супругов (ст. 34 СК РФ)"]
                B_SHARE["В общую долевую собственность (доли 1/2, 1/3, 1/4 детям/взрослым)"]
                B_KIDS["С участием несовершеннолетних (маткапитал 256-ФЗ)"]
            end
        end
    end

    %% Предмет и переход права собственности
    subgraph CORE ["🎯 ПРЕДМЕТ ДОГОВОРА И ОБЪЕКТ (СТ. 549-550 ГК РФ)"]
        PREDMET["1. ПРЕДМЕТ ОДКП: Продавец передает в собственность, а Покупатель принимает и оплачивает объект"]
        DESC["2. ОПИСАТЕЛЬНЫЕ ДАННЫЕ: Точный адрес по ФИАС, кадастровый номер, площадь, этаж, документы-основания права"]
        
        subgraph OBJECTS ["Виды объектов (1 или связка в сделке)"]
            direction TB
            OBJ_FLAT["Квартира"]
            OBJ_HOUSE["Жилой дом + Земельный участок (ст. 552, 555 ГК РФ)"]
            OBJ_LAND["Земельный участок (ИЖС/СНТ)"]
            OBJ_LAND_BLD["ЗУ + Нежилое строение (баня, гараж, сарай)"]
            OBJ_ROOM["Комната в коммуналке (отказы соседей ст. 250 ГК РФ)"]
            OBJ_COMM["Нежилое коммерческое помещение"]
            OBJ_COMM_LND["Нежилое коммерческое помещение + ЗУ"]
        end
        
        STATUS_SHARE["Форма: ДОЛЯ В ПРАВЕ"]
        STATUS_WHOLE["Форма: ОБЪЕКТ ЦЕЛИКОМ"]
    end

    %% Финансы и расчеты
    subgraph FINANCE ["💰 ЦЕНА ДОГОВОРА И ИСПОЛНЕНИЕ РАСЧЕТОВ"]
        PRICE["Полная цена объекта (при Доме+ЗУ - раздельные цены ст. 555 ГК)"]
        ZADATOK_OFFSET["Зачет ранее внесенного задатка/аванса по ПДКП"]
        SETTLE_METHODS["Финальный расчет: СБР (номинальный счет) / Аккредитив / Ячейка / Наличные"]
        MORTGAGE_BLOCK["Ипотечные средства банка (ст. 77 / 64.1 / 64.2 102-ФЗ, залог в силу закона)"]
        MAT_CAP["Средства МСК / Сертификаты (безналично из СФР РФ до 21 дня)"]
        NO_SELLER_PLEDGE["Отказ от залога Продавца (п. 5 ст. 488 ГК РФ НЕ применяется)"]
    end

    %% Регистрация перехода права
    subgraph REGISTRATION ["🏛️ ГОСУДАРСТВЕННАЯ РЕГИСТРАЦИЯ ПРАВА (СТ. 551 ГК РФ)"]
        REG_FILING["Подача на регистрацию: Электронная (Домклик/М2) / Нотариус / МФЦ Росреестра"]
        RIGHT_MOMENT["Момент возникновения права собственности: внесение записи в ЕГРН (ст. 8.1, 223 ГК)"]
        FEES_SPLIT["Распределение расходов: госпошлина, электронная регистрация, банк"]
    end

    %% Существенные условия и защитные блоки
    subgraph ESSENTIAL_BLOCKS ["⚖️ СУЩЕСТВЕННЫЕ И ЗАЩИТНЫЕ УСЛОВИЯ ОДКП"]
        USERS_558["3. ПРАВА ПОЛЬЗОВАНИЯ (ст. 558 ГК РФ): отсутствие прописанных лиц / обязательство выписки за N дней"]
        TRANSFER_556["4. ПЕРЕДАЧА ОБЪЕКТА (ст. 556 ГК РФ): Передаточный акт в течение N дней / договор имеет силу акта"]
        WARRANTIES_431["5. ЗАВЕРЕНИЯ ОБ ОБСТОЯТЕЛЬСТВАХ (ст. 431.2, 460, 461 ГК): юр. чистота, нет долгов/банкротства 127-ФЗ"]
        LIABILITY["6. ОТВЕТСТВЕННОСТЬ СТОРОН: неустойка 0.1%/день за задержку оплаты или освобождения, ст. 461 ГК"]
        FORCE_MAJEURE["7. ФОРС-МАЖОР (Обстоятельства непреодолимой силы ст. 401 ГК РФ)"]
        SIGNATURES["8. АДРЕСА, РЕКВИЗИТЫ И ПОДПИСИ (Построчный формат на всю ширину страницы 17 см)"]
    end

    %% Связи архитектуры
    TITLE_BLOCK --> PARTIES
    S_MAIN --> S_TYPES
    B_MAIN --> B_TYPES

    S_MAIN --> PREDMET
    B_MAIN --> PREDMET
    PREDMET --> DESC
    DESC --> OBJECTS
    OBJECTS --> STATUS_SHARE
    OBJECTS --> STATUS_WHOLE

    B_MAIN --> FINANCE
    FINANCE --> S_MAIN

    S_MAIN --> REGISTRATION
    B_MAIN --> REGISTRATION

    S_MAIN --> ESSENTIAL_BLOCKS
    B_MAIN --> ESSENTIAL_BLOCKS
