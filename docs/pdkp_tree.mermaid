flowchart TD
    %% ШАПКА
    subgraph TITLE_BLOCK ["📄 ШАПКА ПДКП"]
        CITY_L["Место заключения (город)"] --- TITLE_C["БЛОЧНАЯ СТРУКТУРА ПРЕДВАРИТЕЛЬНОГО ДОГОВОРА (ПДКП)"] --- DATE_R["Дата заключения"]
    end

    %% ВЕРТИКАЛЬ ЗАЩИТНЫХ БЛОКОВ
    subgraph LEGAL_COLUMN ["⚖️ ОБЯЗАТЕЛЬСТВА И УСЛОВИЯ СТОРОН"]
        direction TB
        CLOSING["8. Заключительные положения и подписи сторон"]
        FORCE_MAJEURE["7. Форс-мажор (ст. 401 ГК, отказ банка, мобилизация)"]
        LIABILITY["6. Ответственность сторон (судьба задатка ст. 381 ГК, неустойка)"]
        KEYS["5. Сроки освобождения объекта и передача ключей (ст. 556 ГК)"]
        REG_USERS["4. Зарегистрированные лица и сроки снятия с учета"]
        PARITET["3. Паритет намерений (заверения об обстоятельствах ст. 431.2 ГК)"]

        CLOSING --- FORCE_MAJEURE
        FORCE_MAJEURE --- LIABILITY
        LIABILITY --- KEYS
        KEYS --- REG_USERS
        REG_USERS --- PARITET
    end

    %% ПОДГОТОВКА К СДЕЛКЕ
    subgraph PREP ["📋 НЕОБХОДИМАЯ ПОДГОТОВКА К СДЕЛКЕ"]
        DOCS_S["Список документов от Продавца\n(ЕГРН, ЖКХ, СФР по МСК, ПНД)"]
        COND["Условия сделки и действия\n(опека, согласие супругов, банк)"]
        DOCS_B["Список документов от Покупателя\n(паспорта, кредит, средства)"]
        DOCS_S --- COND --- DOCS_B
    end

    %% РАСЧЕТЫ
    SETTLE["💰 Сценарии расчетов в сделках (24 ветки: Наличные, СБР, Аккредитив, Ячейка, Ипотека, МСК)"]

    %% ЦЕНТРАЛЬНЫЙ БЛОК: СТОРОНЫ И ПРЕДМЕТ
    subgraph SIDES_ROW ["👥 СТОРОНЫ И ПРЕДМЕТ СДЕЛКИ"]
        subgraph SELLER_BOX ["🟦 СТОРОНА ПРОДАВЦА"]
            direction TB
            S_MAIN["Продавец (Собственник)"]
            S1["1, 2, 3 Взрослых собственника"]
            S2["1, 2, 3 До 14 лет (родители)"]
            S3["1, 2, 3 От 14 до 18 лет (с согласия)"]
            S4["2 Взрослых супруга (совместная)"]
            S_MAIN --- S1 --- S2 --- S3 --- S4
        end

        subgraph CORE_BOX ["🎯 ПРЕДМЕТ ДОГОВОРА"]
            direction TB
            PREDMET["1. Предмет ПДКП: обязательство заключить\nв будущем ОДКП до определенного срока"]
            DESC["2. Описательные данные объекта: адрес, кад. номер,\nплощадь, документы-основания, комплектация (мебель/техника)"]
            PREDMET --> DESC
        end

        subgraph BUYER_BOX ["🟥 СТОРОНА ПОКУПАТЕЛЯ"]
            direction TB
            B_MAIN["Покупатель (Приобретатель)"]
            B1["1, 2, 3 Взрослых покупателя"]
            B2["1, 2, 3 До 14 лет (родители)"]
            B3["1, 2, 3 От 14 до 18 лет (с согласия)"]
            B4["2 Взрослых супруга (совместная / долевая)"]
            B_MAIN --- B1 --- B2 --- B3 --- B4
        end
    end

    %% КАТАЛОГ ОБЪЕКТОВ
    subgraph OBJECTS_BOX ["🏢 ВИДЫ ОБЪЕКТОВ (1 ИЛИ НЕСКОЛЬКО В СДЕЛКЕ)"]
        direction TB
        subgraph OBJ_LIST ["Список объектов"]
            O1["Квартира"]
            O2["Жилой дом + Земельный участок"]
            O3["Земельный участок (ИЖС/СНТ)"]
            O4["ЗУ + Нежилое строение (баня, гараж, сарай)"]
            O5["Комната в коммуналке (ст. 250 ГК РФ)"]
            O6["Нежилое коммерческое помещение"]
            O7["Нежилое коммерческое + ЗУ"]
        end
        STATUS_SHARE["Форма: ДОЛЯ В ПРАВЕ"]
        STATUS_WHOLE["Форма: ОБЪЕКТ ЦЕЛИКОМ"]
        OBJ_LIST --> STATUS_SHARE
        OBJ_LIST --> STATUS_WHOLE
    end

    %% СВЯЗИ
    S_MAIN --> LEGAL_COLUMN
    B_MAIN --> LEGAL_COLUMN
    S_MAIN --> DOCS_S
    B_MAIN --> DOCS_B
    B_MAIN --> SETTLE --> S_MAIN
    S_MAIN --> PREDMET
    B_MAIN --> PREDMET
    DESC --> OBJECTS_BOX
