flowchart TD
    %% Шапка договора
    subgraph TITLE_BLOCK ["📄 ШАПКА ДОГОВОРА"]
        CITY_L["Место заключения (город)"]
        TITLE_C["БЛОЧНАЯ СТРУКТУРА ПРЕДВАРИТЕЛЬНОГО ДОГОВОРА (ПДКП)"]
        DATE_R["Дата заключения"]
    end

    %% Стороны договора
    subgraph PARTIES ["👥 СТОРОНЫ ДОГОВОРА"]
        direction LR
        subgraph SELLER_BOX ["🟦 СТОРОНА ПРОДАВЦА"]
            S_MAIN["Продавец (Собственник)"]
            subgraph S_TYPES ["Варианты состава Продавца"]
                S_A["1, 2, 3 Взрослых собственника"]
                S_U14["1, 2, 3 Собственника до 14 лет (родители)"]
                S_1418["1, 2, 3 Собственника от 14 до 18 лет (с согласия)"]
                S_SPOUSE["2 Взрослых собственника (Супруги, совместная собств.)"]
            end
        end

        subgraph BUYER_BOX ["🟥 СТОРОНА ПОКУПАТЕЛЯ"]
            B_MAIN["Покупатель (Приобретатель)"]
            subgraph B_TYPES ["Варианты состава Покупателя"]
                B_A["1, 2, 3 Взрослых покупателя"]
                B_U14["1, 2, 3 Покупателя до 14 лет (родители)"]
                B_1418["1, 2, 3 Покупателя от 14 до 18 лет (с согласия)"]
                B_SPOUSE["2 Взрослых покупателя (Супруги, совместная / долевая)"]
            end
        end
    end

    %% Предмет и объект
    subgraph CORE ["🎯 ПРЕДМЕТ И ОБЪЕКТ ПДКП"]
        PREDMET["1. ПРЕДМЕТ ПДКП: Обязательство заключить в будущем ОДКП до определенного срока (дедлайн)"]
        DESC["2. ОПИСАТЕЛЬНЫЕ ДАННЫЕ ОБЪЕКТА: Адрес, кадастровый номер, площадь, правоустановка, мебель/техника"]
        
        subgraph OBJECTS ["Виды объектов (1 или связка в сделке)"]
            direction TB
            OBJ_FLAT["Квартира"]
            OBJ_HOUSE["Жилой дом + Земельный участок"]
            OBJ_LAND["Земельный участок (ИЖС/СНТ)"]
            OBJ_LAND_BLD["ЗУ + Нежилое строение (баня, гараж, сарай)"]
            OBJ_ROOM["Комната в коммуналке (ст. 250 ГК РФ)"]
            OBJ_COMM["Нежилое коммерческое помещение"]
            OBJ_COMM_LND["Нежилое коммерческое помещение + ЗУ"]
        end
        
        STATUS_SHARE["Форма: ДОЛЯ В ПРАВЕ"]
        STATUS_WHOLE["Форма: ОБЪЕКТ ЦЕЛИКОМ"]
    end

    %% Финансы и расчеты
    subgraph FINANCE ["💰 ЦЕНА, ЗАДАТОК И СЦЕНАРИИ РАСЧЕТОВ"]
        PRICE["Полная цена объекта и сумма ЗАДАТКА (ст. 380-381 ГК РФ)"]
        SETTLE_TREE["Сценарии расчетов (24 ветки: Наличные / СБР / Аккредитив / Ячейка / Ипотека / МСК)"]
    end

    %% Подготовка к сделке
    subgraph PREPARATION ["📋 НЕОБХОДИМАЯ ПОДГОТОВКА К СДЕЛКЕ"]
        DOCS_S["Список документов от Продавца: выписка ЕГРН, справки ЖКХ/капремонт, СФР по МСК, ПНД/НД"]
        ACTIONS["Условия и действия: приказ опеки, согласие супруга, одобрение банка, снятие залогов"]
        DOCS_B["Список документов от Покупателя: паспорта, кредитный договор банка, средства на счете"]
    end

    %% Защитные разделы договора
    subgraph LEGAL_BLOCKS ["⚖️ ЗАЩИТНЫЕ УСЛОВИЯ И ОБЯЗАТЕЛЬСТВА"]
        PARITET["3. ПАРИТЕТ НАМЕРЕНИЙ (Заверения об обстоятельствах ст. 431.2 ГК РФ)"]
        REG_USERS["4. ЗАРЕГИСТРИРОВАННЫЕ ЛИЦА (Снятие с рег. учета до сделки или в срок после)"]
        KEYS["5. СРОКИ ОСВОБОЖДЕНИЯ ОБЪЕКТА И ПЕРЕДАЧА КЛЮЧЕЙ (Передаточный акт ст. 556 ГК РФ)"]
        LIABILITY["6. ОТВЕТСТВЕННОСТЬ СТОРОН (Судьба задатка ст. 381 ГК РФ, неустойка 0.1%/день)"]
        FORCE_MAJEURE["7. ФОРС-МАЖОР (Форс-мажор ст. 401 ГК, отказ банка, мобилизация)"]
        CLOSING["8. ЗАКЛЮЧИТЕЛЬНЫЕ ПОЛОЖЕНИЯ И ПОДПИСИ СТОРОН (Построчный формат на всю ширину)"]
    end

    %% Связи архитектуры
    TITLE_BLOCK --> PARTIES
    S_MAIN --> S_TYPES
    B_MAIN --> B_TYPES

    S_MAIN --> PREDMET
    B_MAIN --> PREDMET
    PREDMET --> DESC
    DESC --> OBJECTS
    OBJECTS --> STATUS_SHARE
    OBJECTS --> STATUS_WHOLE

    B_MAIN --> FINANCE
    FINANCE --> S_MAIN

    S_MAIN --> PREPARATION
    B_MAIN --> PREPARATION

    S_MAIN --> LEGAL_BLOCKS
    B_MAIN --> LEGAL_BLOCKS
